{
  "name": "agency-management-system",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "electron"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,electron \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\" \"npm run dev --workspace electron\"",
    "build": "npm run build --workspace frontend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
